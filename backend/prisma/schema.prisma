generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  phone       String
  role        Role     @default(CLIENT)
  avatar      String?
  rating      Float    @default(5.0)
  totalTrips  Int      @default(0)
  fcmToken    String?
  createdAt   DateTime @default(now())

  motoboy             Motoboy?
  lojaProfile         LojaProfile?
  pedidosCliente      Pedido[]              @relation("ClientePedidos")
  avaliacoesFeitas    Avaliacao[]           @relation("AvaliacoesFeitas")
  avaliacoesRecebidas Avaliacao[]           @relation("AvaliacoesRecebidas")
  mensagens           Mensagem[]
  corridasPassageiro  Corrida[]             @relation("CorridasPassageiro")
  pedidosRestaurante  PedidoRestaurante[]   @relation("PedidosRestauranteCliente")
}

enum Role {
  CLIENT
  MOTOBOY
  ADMIN
  LOJA
}

enum TipoLoja {
  PF
  PJ
}

model Motoboy {
  id         String        @id @default(uuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id])
  cnh        String
  cnhUrl     String?
  vehicle    String
  plate      String
  status     MotoboyStatus @default(PENDING)
  lat        Float?
  lng        Float?
  locationAt DateTime?

  assinatura       Assinatura?
  pedidos          Pedido[]         @relation("MotoboyPedidos")
  propostas        Proposta[]
  corridas         Corrida[]        @relation("MotoboysCorridas")
  propostasCorrida PropostaCorrida[]
}

enum MotoboyStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Plano {
  id          String       @id @default(uuid())
  name        String
  price       Float
  description String
  active      Boolean      @default(true)
  assinaturas Assinatura[]
}

model Assinatura {
  id        String           @id @default(uuid())
  motoboyId String           @unique
  motoboy   Motoboy          @relation(fields: [motoboyId], references: [id])
  planoId   String
  plano     Plano            @relation(fields: [planoId], references: [id])
  status    AssinaturaStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?
  mpSubId   String?
  createdAt DateTime         @default(now())
}

enum AssinaturaStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Pedido {
  id               String       @id @default(uuid())
  clienteId        String
  cliente          User         @relation("ClientePedidos", fields: [clienteId], references: [id])
  motoboyId        String?
  motoboy          Motoboy?     @relation("MotoboyPedidos", fields: [motoboyId], references: [id])
  origemEndereco   String
  origemLat        Float
  origemLng        Float
  destinoEndereco  String
  destinoLat       Float
  destinoLng       Float
  distanciaKm      Float
  tempoEstimadoMin Int
  valorProposto    Float
  valorCalculado   Float?
  valorFinal       Float?
  descricao        String?
  status           PedidoStatus @default(WAITING_OFFERS)
  expiresAt        DateTime
  aceitoAt         DateTime?
  entregueAt       DateTime?
  createdAt        DateTime     @default(now())

  propostas  Proposta[]
  mensagens  Mensagem[]
  avaliacoes Avaliacao[]
}

enum PedidoStatus {
  WAITING_OFFERS
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
  EXPIRED
}

model Proposta {
  id        String         @id @default(uuid())
  pedidoId  String
  pedido    Pedido         @relation(fields: [pedidoId], references: [id])
  motoboyId String
  motoboy   Motoboy        @relation(fields: [motoboyId], references: [id])
  valor     Float
  status    PropostaStatus @default(PENDING)
  createdAt DateTime       @default(now())
}

enum PropostaStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Mensagem {
  id        String   @id @default(uuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  texto     String
  createdAt DateTime @default(now())
}

model Avaliacao {
  id          String   @id @default(uuid())
  pedidoId    String?
  pedido      Pedido?  @relation(fields: [pedidoId], references: [id])
  corridaId   String?
  corrida     Corrida? @relation(fields: [corridaId], references: [id])
  avaliadorId String
  avaliador   User     @relation("AvaliacoesFeitas", fields: [avaliadorId], references: [id])
  avaliadoId  String
  avaliado    User     @relation("AvaliacoesRecebidas", fields: [avaliadoId], references: [id])
  nota        Int
  comentario  String?
  createdAt   DateTime @default(now())
}

// ── Mototaxi ──────────────────────────────────────────────────────────────────

model Corrida {
  id               String        @id @default(uuid())
  passageiroId     String
  passageiro       User          @relation("CorridasPassageiro", fields: [passageiroId], references: [id])
  motoboyId        String?
  motoboy          Motoboy?      @relation("MotoboysCorridas", fields: [motoboyId], references: [id])
  origemEndereco   String
  origemLat        Float
  origemLng        Float
  destinoEndereco  String
  destinoLat       Float
  destinoLng       Float
  distanciaKm      Float
  tempoEstimadoMin Int
  valorSugerido    Float
  valorFinal       Float?
  status           CorridaStatus @default(AGUARDANDO)
  expiresAt        DateTime
  aceitaAt         DateTime?
  concluidaAt      DateTime?
  createdAt        DateTime      @default(now())

  propostas PropostaCorrida[]
  avaliacoes Avaliacao[]
}

enum CorridaStatus {
  AGUARDANDO
  ACEITA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  EXPIRADA
}

model PropostaCorrida {
  id        String                @id @default(uuid())
  corridaId String
  corrida   Corrida               @relation(fields: [corridaId], references: [id])
  motoboyId String
  motoboy   Motoboy               @relation(fields: [motoboyId], references: [id])
  valor     Float
  status    PropostaCorridaStatus @default(PENDENTE)
  createdAt DateTime              @default(now())
}

enum PropostaCorridaStatus {
  PENDENTE
  ACEITA
  REJEITADA
}

// ── Restaurantes ──────────────────────────────────────────────────────────────

model Restaurante {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  categoria String   @default("Restaurante")
  logo      String?
  endereco  String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  lojaProfile LojaProfile?
  categorias CategoriaCardapio[]
  produtos   ProdutoCardapio[]
  pedidos    PedidoRestaurante[]
}

model LojaProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id])
  tipo          TipoLoja   @default(PF)
  documento     String     // CPF (PF) ou CNPJ (PJ)
  nomeFantasia  String?
  restauranteId String?    @unique
  restaurante   Restaurante? @relation(fields: [restauranteId], references: [id])
  createdAt     DateTime   @default(now())
}

model CategoriaCardapio {
  id            String      @id @default(uuid())
  nome          String
  icone         String?     @default("🍽️")
  restauranteId String
  restaurante   Restaurante @relation(fields: [restauranteId], references: [id])
  produtos      ProdutoCardapio[]

  @@unique([nome, restauranteId])
}

model ProdutoCardapio {
  id            String            @id @default(uuid())
  nome          String
  preco         Float
  descricao     String?
  imagem        String?
  disponivel    Boolean           @default(true)
  categoriaId   String
  categoria     CategoriaCardapio @relation(fields: [categoriaId], references: [id])
  restauranteId String
  restaurante   Restaurante       @relation(fields: [restauranteId], references: [id])
  createdAt     DateTime          @default(now())
}

model PedidoRestaurante {
  id            String                  @id @default(uuid())
  numero        Int
  nomeCliente   String                  @default("-")
  total         Float
  observacoes   String?
  status        StatusPedidoRestaurante @default(PENDENTE)
  restauranteId String
  restaurante   Restaurante             @relation(fields: [restauranteId], references: [id])
  clienteId     String?
  cliente       User?                   @relation("PedidosRestauranteCliente", fields: [clienteId], references: [id])
  entregaPropria Boolean               @default(true)
  createdAt     DateTime                @default(now())

  itens ItemPedidoRestaurante[]
}

model ItemPedidoRestaurante {
  id        String            @id @default(uuid())
  nome      String
  preco     Float
  quantidade Int              @default(1)
  imagem    String?
  pedidoId  String
  pedido    PedidoRestaurante @relation(fields: [pedidoId], references: [id])
}

enum StatusPedidoRestaurante {
  PENDENTE
  PREPARANDO
  PRONTO
  ENTREGANDO
  ENTREGUE
  CANCELADO
  CONCLUIDO
}
